# Copy to .env.local for `vercel dev`, and set the SAME variables in
# Vercel → Project → Settings → Environment Variables (Production).
#
# Each block below powers one part of the dashboard. A missing block does not
# break the page — the affected route returns 500 and the board silently falls
# back to its embedded snapshot, which goes stale. Check /api/health to see
# which blocks are actually configured on a deployment.

# ---- Access gate (middleware.js) --------------------------------------------
# REQUIRED. Without SITE_PASSWORD every page returns 503 (fail-closed by design).
# The dashboard exposes full P&L, so do not leave this unset.
SITE_PASSWORD=choose-a-shared-password
SITE_USER=diggerlid
# Setting SITE_PUBLIC=true disables the gate entirely and makes the financials
# readable by anyone with the URL. Only set it if that is genuinely intended.
# SITE_PUBLIC=true

# ---- Google Sheet P&L  → /api/data  (Daily Ops, Performance, Pulse) ---------
# Share the sheet (Viewer) with GOOGLE_SERVICE_ACCOUNT_EMAIL first, or the
# route authenticates fine and still returns nothing.
GOOGLE_SERVICE_ACCOUNT_EMAIL=diggerlid-dashboard@your-project.iam.gserviceaccount.com
# Paste the whole private key on ONE line with \n between lines, wrapped in quotes:
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n...\n-----END PRIVATE KEY-----\n"
# Optional overrides:
SHEET_ID=1rAut5J3SoDvH0ObdVuTenqGjiO-u7M6cPpRNQ5Hqpnw
SHEET_YEAR=26

# ---- Shopify  → /api/shopify  (Products, Region) ----------------------------
# SHOPIFY_STORE is the *.myshopify.com subdomain only — no protocol, no suffix.
# Token needs read_reports (+ read_products / read_orders). Read-only.
SHOPIFY_STORE=your-store
SHOPIFY_TOKEN=shpat_...
# Optional override:
SHOPIFY_API_VERSION=2025-01

# ---- PostHog  → /api/pulse  (Pulse site signals) ----------------------------
POSTHOG_API_KEY=phx_...
# Optional overrides:
POSTHOG_HOST=https://us.posthog.com
POSTHOG_PROJECT_ID=475333
