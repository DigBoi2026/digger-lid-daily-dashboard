# Copy to .env.local for `vercel dev`, and set the SAME variables in
# Vercel → Project → Settings → Environment Variables (Production).
#
# Each block below powers one part of the dashboard. A missing block does not
# break the page — the affected route returns 500 and the board silently falls
# back to its embedded snapshot, which goes stale. Check /api/health to see
# which blocks are actually configured on a deployment.

# ---- Access gate (middleware.js) --------------------------------------------
# REQUIRED. Without SITE_PASSWORD every page returns 503 (fail-closed by design).
# The dashboard exposes full P&L, so do not leave this unset.
SITE_PASSWORD=choose-a-shared-password
SITE_USER=diggerlid
# Setting SITE_PUBLIC=true disables the gate entirely and makes the financials
# readable by anyone with the URL. Only set it if that is genuinely intended.
# SITE_PUBLIC=true

# ---- Google Sheet P&L  → /api/data  (Daily Ops, Performance, Pulse) ---------
# Share the sheet (Viewer) with GOOGLE_SERVICE_ACCOUNT_EMAIL first, or the
# route authenticates fine and still returns nothing.
GOOGLE_SERVICE_ACCOUNT_EMAIL=diggerlid-dashboard@your-project.iam.gserviceaccount.com
# In THIS file: one line, \n between lines, wrapped in quotes (shell parsing).
# In the VERCEL DASHBOARD: paste the key as-is with real newlines and NO quotes —
# quotes typed there become part of the value and break the PEM parse. The code
# accepts either form (it rewrites literal \n to real newlines).
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n...\n-----END PRIVATE KEY-----\n"
# Optional overrides:
SHEET_ID=1rAut5J3SoDvH0ObdVuTenqGjiO-u7M6cPpRNQ5Hqpnw
SHEET_YEAR=26

# ---- Shopify  → /api/shopify  (Products, Region) ----------------------------
# SHOPIFY_STORE is the *.myshopify.com subdomain only — no protocol, no suffix.
# Only scope needed is read_reports: every query is ShopifyQL over `sales`.
SHOPIFY_STORE=your-store

# Set ONE of the two credential shapes below.
#
# (a) A long-lived token, as issued to admin-created custom apps. Shopify no
#     longer lets you create those apps, but existing ones keep working —
#     Apps → Develop apps → [app] → API credentials.
# SHOPIFY_TOKEN=shpat_...
#
# (b) An app made with the Shopify CLI / Dev Dashboard. The route exchanges
#     these for a token via the client credentials grant. That grant ONLY works
#     when the app and the store sit in the same Shopify organisation —
#     otherwise it fails with shop_not_permitted. Tokens last 24h and are
#     minted on demand, so nothing needs rotating by hand.
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# Optional override. Pin a live version — a retired one is silently served by
# whatever is oldest-supported that quarter, so the target moves under you.
SHOPIFY_API_VERSION=2026-07

# ---- PostHog  → /api/pulse  (Pulse site signals) ----------------------------
POSTHOG_API_KEY=phx_...
# Optional overrides:
POSTHOG_HOST=https://us.posthog.com
POSTHOG_PROJECT_ID=475333

# ---- AI read subsystem  → /api/ai/*  ----------------------------------------
# One entry per AI consumer, so any single agent can be revoked without
# disturbing the others. Tokens are read-only; there is no write path.
#
# Scopes:
#   pnl.full     every P&L field, including cost structure, salaries and profit
#   pnl.topline  trading and marketing metrics only — no costs, salaries, profit
#   products     Shopify product and category sales
#   region       Shopify sales by country and region
#   pulse        PostHog site signals
#
# Generate a token with:  echo "sk_dl_$(openssl rand -hex 24)"
AI_TOKENS=[{"name":"media-buyer","token":"sk_dl_...","scopes":["pnl.topline","pulse"]}]
